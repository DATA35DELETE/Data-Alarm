QPushButton {
    background-color: #e9e9e9;
    padding: 4px;
    color: #82C445;
    border: 2px solid #a8a8a8;
    border-radius: 12px;

    font: 600 12pt "Bahnschrift SemiBold";
}
QPushButton:hover {
    background-color: #a5b9a5;
    color: #A3FF5C;
    border: 2px solid #82C445;
}
QPushButton:pressed {
    background-color: #87b37e;
    color: #82C445;
    border: 2px solid #659C36;
}
QPushButton:disabled {
    background-color: #d1d1d1;
    color: #555555;
    border: 2px solid #2B2B2B;
}

QLabel {
    border-radius: 12px;
