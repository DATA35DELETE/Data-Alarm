QSpinBox {
    background-color: #e9e9e9;
    color: #82C445;

    border: 2px solid #a8a8a8;
    border-radius: 10px;

    padding: 6px 8px;

    font: 600 11pt "Bahnschrift SemiBold";

    selection-background-color: #35452D;
    selection-color: #A3FF5C;
}
QSpinBox:hover {
    background-color: #a5b9a5;
    border: 2px solid #82C445;
    color: #A3FF5C;
}
QSpinBox:focus {
    border: 2px solid #659C36;
}
QSpinBox:disabled {
    background-color: #d1d1d1;
    color: #555555;
    border: 2px solid #2B2B2B;
}
QSpinBox::up-button,
QSpinBox::down-button {
    background-color: #303030;

    width: 24px;

    border: none;
    border-left: 1px solid #a8a8a8;
}
QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;

    border-top-right-radius: 8px;
}
QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;

    border-bottom-right-radius: 8px;
}
QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
    background-color: #3A4435;
    border-left: 1px solid #82C445;
}
QSpinBox::up-button:pressed,
QSpinBox::down-button:pressed {
    background-color: #87b37e;
}
QSpinBox::up-arrow {
    image: url(:/icons/yukariOk.png);
    width: 10px;
    height: 10px;
}
QSpinBox::down-arrow {
    image: url(:/icons/asagiOk.png);
    width: 10px;
    height: 10px;
}

