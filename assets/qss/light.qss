QListView {
    background-color: #e9e9e9;
    color: #82C445;
    border: 2px solid #a8a8a8;
    border-radius: 12px;
    font: 600 11pt "Bahnschrift SemiBold";
    padding: 6px;
    outline: none;
    show-decoration-selected: 1;
    alternate-background-color: #292929;
}
QListView::item {
    background-color: transparent;
    color: #82C445;
    border: 1px solid transparent;
    border-radius: 6px;
    margin: 2px;
}
QListView::item:hover {
    background-color: #a5b9a5;
    color: #A3FF5C;
    border: 1px solid #89b377;
}
QListView::item:selected {
    background-color: #88b174;
    color: #A3FF5C;
    border: 1px solid #82C445;
}
QListView::item:selected:hover {
    background-color: #678656;
    color: #B4FF80;
    border: 1px solid #A3FF5C;
}
QListView:disabled {
    background-color: #d1d1d1;
    color: #555555;
    border: 2px solid #2B2B2B;
}

QScrollBar{
    border-radius: 10px;
}
QScrollBar:vertical {
    background-color: #d1d1d1;
    width: 12px;
    margin: 4px 2px 4px 2px;
    border: none;
    border-radius: 6px;
}
QScrollBar::handle:vertical {
    background-color: #454545;
    min-height: 30px;
    border-radius: 5px;
    border: 1px solid #505050;
}
QScrollBar::handle:vertical:hover {
    background-color: #82C445;
    border: 1px solid #A3FF5C;
}
QScrollBar::handle:vertical:pressed {
    background-color: #659C36;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background-color: transparent;
}
QScrollBar:horizontal {
    background-color: #d1d1d1;
    height: 12px;
    margin: 2px 4px 2px 4px;
    border: none;
    border-radius: 6px;
}
QScrollBar::handle:horizontal {
    background-color: #454545;
    min-width: 30px;
    border-radius: 5px;
    border: 1px solid #505050;
}
QScrollBar::handle:horizontal:hover {
    background-color: #82C445;
    border: 1px solid #A3FF5C;
}
QScrollBar::handle:horizontal:pressed {
    background-color: #659C36;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
    border: none;
}
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background-color: transparent;
}

