}
QToolBox::tab {
    color: #82C445;

    border: 1px solid #a8a8a8;
    border-bottom: 2px solid #454545;
    border-radius: 8px;

    font: 600 11pt "Bahnschrift SemiBold";
}
QToolBox::tab:hover {
    background-color: #a5b9a5;
    color: #A3FF5C;

    border: 1px solid #82C445;
}
QToolBox::tab:selected {
    background-color: #35452D;
    color: #A3FF5C;

    border: 1px solid #82C445;
    border-bottom: 2px solid #A3FF5C;
